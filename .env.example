# Copy to .env. Never commit the filled file.
# CISA KEV needs no credential; every other source does. See docs/sources.md.

# abuse.ch (URLhaus, ThreatFox, MalwareBazaar, Feodo Tracker) — free Auth-Key,
# mandatory since the 2023 API change.
ABUSECH_AUTH_KEY=

# AbuseIPDB — free tier, low daily quota. Check redistribution terms first.
ABUSEIPDB_API_KEY=

# GreyNoise Community — enrichment only, very low rate limit.
GREYNOISE_API_KEY=

# NVD — optional; without a key the rate limit is much lower.
NVD_API_KEY=
